{
    "manifest_version": 3,
    "name": "Têmis",
    "version": "1.0.0",
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "assets/icons/16.png",
            "32": "assets/icons/32.png"
        }
    },
    "icons": {
        "16": "assets/icons/16.png",
        "32": "assets/icons/32.png",
        "48": "assets/icons/48.png",
        "128": "assets/icons/128.png"
    },
    "permissions": [
        "storage"
    ]
}